# Normalize text while preserving Markdown's semantic two-space hard breaks.
* text=auto
*.md text whitespace=-trailing-space

# Never apply text conversions to source documents or image assets.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary

# Preserve imported research evidence byte-for-byte; review it through the canonical integration documents.
docs/research/dossiers/**/PRISM_RESEARCH_AND_IMPLEMENTATION_DOSSIER.md binary
docs/research/dossiers/**/PRISM_RESEARCH_AND_IMPLEMENTATION_DOSSIER.html binary
